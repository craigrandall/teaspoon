# Cargo build artifacts
/target/
**/*.rs.bk

# Cargo.lock is checked in on purpose: teaspoon builds a binary (`tsp`), and the CI gate and the
# verification evidence depend on a reproducible dependency set.

# IDE
/.idea/
/.vscode/
*.iml

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Personal notes
/_NOTES/

# Outlook-related
*.pst
*.ost
*.msg
*.eml

# Export output and staging. An archive holds message content (headers, bodies, attachments):
# never commit one.
out/
tsp-out/
.tsp-tmp/
